import java.util.Scanner;

public class Inventory {
        
    String[][] inventory = new String[6][5];   // initialized array with 30 slots

    public static void main(String[] args) {
        int track = 0; // counts size of inventory
        Inventory Inventory = new Inventory();
        Scanner user = new Scanner(System.in);
        
        while (track < 30 && user.hasNextLine()) { // while all indexes in inventory aren't full, will prompt user to add or delete items
             String item = user.nextLine();
             if (item.length() >= 6 && item.substring(0, 6).equalsIgnoreCase("Remove")) {  //calls removeItem if true
               System.out.println("Remove");    //test
                Inventory.removeItem(item);
                track--;
               
            } 
              else if (item.length() >= 4 && item.substring(0, 3).equalsIgnoreCase("Add")){    // calls selectItem if true 
                 System.out.println("select");  //test
                 Inventory.selectItem(item);
             }
              else {                                                   // calls addItem if true
                 System.out.println("add");   //test
                 Inventory.addItem(item);
                 track++;
            }
        }
        
        
    
        if (track == 30) {
            System.out.println("Inventory is full!");
        }
        
        user.close();
    }

    public void addItem(String object) {
        // Puts item in first available index when location not specified, starting from left to right. 
        for (int i = 0; i < inventory.length; i++) {
            for (int j = 0; j < inventory[i].length; j++) {
                if (inventory[i][j] == null) {
                    inventory[i][j] = object;
                    printInventory();
                    System.out.println("------------------------------------------");  //for organization
                    return;
                }
            }
        }
    }

    public void removeItem(String item) {
        /*  Takes item and deletes it at the first found index.
        If no item is there, the user is told no item was found. */ 
        int strLen = item.length();
        String realItem = item.substring(7, strLen).trim(); // Trim to remove any extra spaces
        boolean found = false;

        for (int i = 0; i < inventory.length; i++) {
            for (int j = 0; j < inventory[i].length; j++) {
                if (inventory[i][j] != null && inventory[i][j].equals(realItem)) { // Check for null
                    inventory[i][j] = null; // Set to null to indicate the slot is empty
                    found = true;
                    break;
                }
            }
            if (found) break;
        }
        if (!found) {
            System.out.println("Item [" + realItem + "] not found in list");
        } else {
            printInventory();
        }
    }

    public void selectItem(String item){        
     int strLen = item.length();                                  // gets items length
     int numTrim = strLen - 1;                                    // takes off the num at end of item
      String realItem = item.substring(4, numTrim).trim();         // creates real item
         for (int i = 0; i < inventory.length; i++) {
            for (int j = 0; j < inventory[i].length; j++) {
                if (inventory[i][j] == null){ //************FIGURE OUT HOW TO TURN USER NUM INTO RC COORDINATE************  "Add cookie 3" use for testing
                  inventory[i][j] = realItem;  //
                  printInventory();
                    System.out.println("------------------------------------------");   //for organization
                    return;
                }
                 else 
                    System.out.println("Idex is already full");
                }
    }
    }

    public void printInventory() { // prints out inventory
     System.out.println("--------INVENTORY-------------------------");
        for (int i = 0; i < inventory.length; i++) {
            for (int j = 0; j < inventory[i].length; j++) {
                if (inventory[i][j] == null) {
                    System.out.print("[empty] ");
                } else {
                    System.out.print("[" + inventory[i][j] + "] ");
                }
            }
            System.out.println("");
        }
    }

    
}
